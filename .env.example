# Copy to .env and fill in for local dev. Never commit .env.
# CLAUDE.md §12: secrets via .env locally, Secret Manager in the cloud.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Postgres (docker/docker-compose.yml maps host port 5433 -> container 5432) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=continuum
POSTGRES_USER=continuum
POSTGRES_PASSWORD=continuum_local_dev

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LiteLLM gateway (CLAUDE.md I7 — no provider SDK outside continuum/llm/) ---
# Empty = call the provider directly via LiteLLM (DeepSeek API). Set to use a LiteLLM proxy.
LITELLM_BASE_URL=
LITELLM_API_KEY=
DEEPSEEK_API_KEY=

# --- Data build ---
DATA_SEED=20260101

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
